export const PATTERNS: Pattern[] = RAW.map(make);

export const DEFAULT_PATTERN_ID = "night-shift";

export function patternById(id: string): Pattern | undefined {
  return PATTERNS.find((pattern) => pattern.id === id);
}

export function gridFromPattern(pattern: Pattern): Grid {
  const grid = {} as Grid;
  for (const track of TRACKS) {
    const source = pattern.tracks[track.id];
    grid[track.id] = Array.from({ length: 32 }, (_, index) => {
      const cell = source[index];
      return cell ? { ...cell } : emptyCell();
    });
  }
  return grid;
}

const SCALE = [0, 3, 5, 7, 10, 12, -7];

export function varyGrid(grid: Grid, stepCount: number, locks: Record<TrackId, boolean>): Grid {
  const next = structuredClone(grid);
  for (const track of TRACKS) {
    if (locks[track.id]) continue;
    const cells = next[track.id];
    const before = cells.map((cell) => cell.vel);
    for (let index = 0; index < stepCount; index += 1) {
      const cell = cells[index];
      if (track.id === "hat" || track.id === "open") {
        if (Math.random() < 0.18) {
          if (cell.vel === 0) cell.vel = Math.random() < 0.55 ? 42 : 100;
          else if (Math.random() < 0.4) cell.vel = 0;
          else cell.vel = cell.vel >= 110 ? 42 : 100;
        }
        if (track.id === "hat" && index > stepCount - 5 && Math.random() < 0.4) {
          cell.roll = Math.random() < 0.5 ? 2 : 3;
          if (cell.vel === 0) cell.vel = 100;
        }
      } else if (track.id === "kick") {
        if (index > 0 && before[index] > 0 && Math.random() < 0.22) {
          const dir = Math.random() < 0.5 ? -1 : 1;
          const target = index + dir;
          if (target > 0 && target < stepCount && cells[target].vel === 0) {
            cells[target] = { ...cell, vel: before[index] };
            cell.vel = 0;
          }
        }
      } else if (track.id === "bass" && cell.vel > 0 && Math.random() < 0.22) {
        cell.note = SCALE[Math.floor(Math.random() * SCALE.length)] ?? 0;
        if (Math.random() < 0.35) cell.slide = !cell.slide;
      } else if (cell.vel > 0 && Math.random() < 0.08) {
        cell.vel = 0;
      } else if (cell.vel === 0 && Math.random() < 0.04 && track.id !== "crash") {
        cell.vel = 100;
      }
    }
  }
  return next;
}

