function pushHistory(history: Grid[], grid: Grid): Grid[] {
  const next = history.concat(structuredClone(grid));
  return next.length > 30 ? next.slice(next.length - 30) : next;
}

function stampCell(state: DrumState, track: TrackId): StepCell {
  if (state.paint === "erase") return emptyCell();
  const vel = state.paint === "ghost" ? VEL_GHOST : state.paint === "accent" ? VEL_ACCENT : VEL_HIT;
  return {
    vel,
    roll: 1,
    note: track === "bass" ? state.armedNote : 0,
    slide: track === "bass" ? state.slideArm : false,
  };
}

function sameCell(a: StepCell, b: StepCell, track: TrackId): boolean {
  if (a.vel !== b.vel) return false;
  if (track !== "bass") return true;
  return a.note === b.note && a.slide === b.slide;
}

function withLane(grid: Grid, track: TrackId, index: number, cell: StepCell): Grid {
  const lane = grid[track].slice();
  lane[index] = cell;
  return { ...grid, [track]: lane };
}

export function toSchedule(state: DrumState): Schedule {
  const trackThreshold = {} as Record<TrackId, boolean>;
  const trackMute = {} as Record<TrackId, boolean>;
  const trackSolo = {} as Record<TrackId, boolean>;
  const volumes = {} as Record<TrackId, number>;
  for (const track of TRACKS) {
    trackThreshold[track.id] = state.tracks[track.id].threshold;
    trackMute[track.id] = state.tracks[track.id].mute;
    trackSolo[track.id] = state.tracks[track.id].solo;
    volumes[track.id] = state.tracks[track.id].volume;
  }
  return {
    grid: state.grid,
    stepCount: state.stepCount,
    bpm: state.bpm,
    swing: state.swing,
    threshold: state.threshold,
    thresholdMaster: state.thresholdMaster,
    trackThreshold,
    trackMute,
    trackSolo,
    volumes,
    bassRoot: bassRootOf(state.octave, state.pitchClass),
    sound: state.sound,
    master: state.master,
  };
}

function persistable(state: DrumState) {
  return {
    v: 1,
    bpm: state.bpm,
    swing: state.swing,
    stepCount: state.stepCount,
    grid: state.grid,
