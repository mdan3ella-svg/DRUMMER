}

function emptyGrid(): Grid {
  const grid = {} as Grid;
  for (const track of TRACKS) grid[track.id] = Array.from({ length: 32 }, () => emptyCell());
  return grid;
}

export const useDrum = create<DrumState>((set, get) => ({
  bpm: starter.bpm,
  swing: starter.swing,
  stepCount: starter.stepCount,
  page: 0,
  grid: gridFromPattern(starter),
  patternId: starter.id,
  patternName: starter.name,
  genre: starter.genre,
  group: starter.group,
  basePatternId: starter.id,
  feel: starter.feel,
  edited: false,
  tracks: defaultMix(),
  threshold: 70,
  thresholdMaster: false,
  sound: defaultSound(starter.drive),
  master: 0.86,
  octave: 1,
  pitchClass: 5,
  armedNote: 0,
  slideArm: false,
  paint: "hit",
  active: "kick",
  playing: false,
  recording: false,
  step: -1,
  cursor: 0,
  exportBars: 8,
  saved: [],
  history: [],
  setBpm: (bpm) => set({ bpm: Math.max(60, Math.min(190, Math.round(bpm))) }),
  setSwing: (swing) => set({ swing: Math.max(0, Math.min(0.65, swing)) }),
  setMaster: (master) => set({ master: Math.max(0, Math.min(1, master)) }),
  setThreshold: (threshold) => set({ threshold: Math.max(1, Math.min(127, Math.round(threshold))) }),
  setThresholdMaster: (thresholdMaster) => set({ thresholdMaster }),
  setSound: (patch) => set((state) => ({ sound: { ...state.sound, ...patch } })),
  setPaint: (paint) => set({ paint }),
  setActive: (active) => set({ active }),
  setPage: (page) => set({ page }),
  setStepCount: (stepCount) =>
    set((state) => {
      if (stepCount === state.stepCount) return state;
      if (stepCount === 16) return { stepCount, page: 0 };
      const grid = structuredClone(state.grid);
      for (const track of TRACKS) {
        const empty = grid[track.id].slice(16, 32).every((cell) => cell.vel === 0);
        if (empty) {
          for (let index = 0; index < 16; index += 1) {
            grid[track.id][16 + index] = { ...grid[track.id][index]! };
          }
        }
      }
      return { stepCount, grid, edited: true, history: pushHistory(state.history, state.grid) };
    }),
  setExportBars: (exportBars) => set({ exportBars }),
  setKey: (pitchClass, octave) =>
    set((state) => ({
      pitchClass,
      octave: octave ?? state.octave,
    })),
  setArmed: (armedNote) => set({ armedNote }),
  toggleSlideArm: () => set((state) => ({ slideArm: !state.slideArm })),
  togglePlayFlag: (playing) => set({ playing, step: playing ? 0 : -1 }),
  toggleRecording: () =>
    set((state) => ({ recording: !state.recording, cursor: state.recording ? state.cursor : 0 })),
  setStep: (step) => set({ step }),
  advanceCursor: () => set((state) => ({ cursor: (state.cursor + 1) % state.stepCount })),
  paintStep: (track, index) =>
    set((state) => {
      const current = state.grid[track][index] ?? emptyCell();
      const stamped = stampCell(state, track);
      const next = state.paint !== "erase" && sameCell(current, stamped, track) ? emptyCell() : stamped;
      return {
        grid: withLane(state.grid, track, index, next),
        edited: true,
        history: pushHistory(state.history, state.grid),
        active: track,
      };
    }),
  stampStep: (track, index) =>
    set((state) => ({
      grid: withLane(state.grid, track, index, stampCell(state, track)),
      edited: true,
      history: pushHistory(state.history, state.grid),
      active: track,
    })),
  cycleExtra: (track, index) =>
    set((state) => {
      const current = { ...(state.grid[track][index] ?? emptyCell()) };
      if (track === "hat" || track === "open") {
        current.roll = current.roll === 1 ? 2 : current.roll === 2 ? 3 : 1;
        if (current.vel === 0) current.vel = VEL_HIT;
      } else if (track === "bass") {
        if (current.vel === 0) return state;
        current.slide = !current.slide;
      } else {
        return state;
      }
      return {
        grid: withLane(state.grid, track, index, current),
        edited: true,
        history: pushHistory(state.history, state.grid),
      };
    }),
  toggleMute: (track) =>
    set((state) => ({
      tracks: {
        ...state.tracks,
        [track]: { ...state.tracks[track], mute: !state.tracks[track].mute },
      },
    })),
  toggleSolo: (track) =>
    set((state) => ({
      tracks: {
        ...state.tracks,
        [track]: { ...state.tracks[track], solo: !state.tracks[track].solo },
      },
    })),
  toggleTrackThreshold: (track) =>
    set((state) => ({
      tracks: {
        ...state.tracks,
        [track]: { ...state.tracks[track], threshold: !state.tracks[track].threshold },
      },
    })),
  toggleLock: (track) =>
    set((state) => ({
      tracks: {
        ...state.tracks,
        [track]: { ...state.tracks[track], lock: !state.tracks[track].lock },
      },
    })),
  setVolume: (track, volume) =>
    set((state) => ({
      tracks: {
        ...state.tracks,
        [track]: { ...state.tracks[track], volume: Math.max(0, Math.min(1, volume)) },
      },
    })),
  clearTrack: (track) =>
    set((state) => ({
      grid: { ...state.grid, [track]: Array.from({ length: 32 }, () => emptyCell()) },
      edited: true,
      history: pushHistory(state.history, state.grid),
    })),
  loadPattern: (id) => {
    const pattern = patternById(id);
    if (!pattern) return;
    set((state) => ({
      history: pushHistory(state.history, state.grid),
      grid: gridFromPattern(pattern),
      bpm: pattern.bpm,
      swing: pattern.swing,
      stepCount: pattern.stepCount,
      page: 0,
      patternId: pattern.id,
      patternName: pattern.name,
      genre: pattern.genre,
      group: pattern.group,
      basePatternId: pattern.id,
      feel: pattern.feel,
      edited: false,
      sound: { ...state.sound, drive: pattern.drive },
      cursor: 0,
    }));
  },
  auto: () =>
    set((state) => {
      const locks = {} as Record<TrackId, boolean>;
      for (const track of TRACKS) locks[track.id] = state.tracks[track.id].lock;
      return {
        history: pushHistory(state.history, state.grid),
        grid: varyGrid(state.grid, state.stepCount, locks),
        patternId: "auto",
        patternName: `Auto ${state.group}`,
        edited: true,
      };
    }),
  reset: () => {
    const id = get().basePatternId;
    get().loadPattern(patternById(id) ? id : DEFAULT_PATTERN_ID);
  },
  blank: () =>
    set((state) => ({
      history: pushHistory(state.history, state.grid),
      grid: emptyGrid(),
      stepCount: 16,
      page: 0,
      patternId: "blank",
      patternName: "Blank",
      genre: "Custom",
      feel: "Empty grid. Paint steps, or record the pads in.",
      edited: false,
      cursor: 0,
    })),
  undo: () =>
    set((state) => {
      const history = state.history.slice();
      const grid = history.pop();
      if (!grid) return state;
      return { history, grid, edited: true };
    }),
  saveBeat: (name) =>
    set((state) => {
      const beat: SavedBeat = {
        id: `beat-${Date.now()}`,
        name: name.trim() || "Untitled",
        savedAt: Date.now(),
        bpm: state.bpm,
        swing: state.swing,
        stepCount: state.stepCount,
        grid: structuredClone(state.grid),
        octave: state.octave,
        pitchClass: state.pitchClass,
        drive: state.sound.drive,
        threshold: state.threshold,
        thresholdMaster: state.thresholdMaster,
        tracks: structuredClone(state.tracks),
        sound: { ...state.sound },
      };
      return { saved: [beat, ...state.saved].slice(0, 24) };
    }),
  deleteBeat: (id) => set((state) => ({ saved: state.saved.filter((beat) => beat.id !== id) })),
  loadBeat: (id) =>
    set((state) => {
      const beat = state.saved.find((item) => item.id === id);
      if (!beat) return state;
      return {
        history: pushHistory(state.history, state.grid),
        grid: structuredClone(beat.grid),
        bpm: beat.bpm,
        swing: beat.swing,
        stepCount: beat.stepCount,
        page: 0,
        tracks: structuredClone(beat.tracks),
        threshold: beat.threshold,
        thresholdMaster: beat.thresholdMaster,
        sound: { ...beat.sound },
        octave: beat.octave,
        pitchClass: beat.pitchClass,
        patternId: beat.id,
        patternName: beat.name,
        genre: "My Beats",
        feel: "Saved in this browser.",
        edited: false,
        basePatternId: state.basePatternId,
      };
    }),
  hydrate: (raw) => {
    if (!raw) return;
    try {
      const data = JSON.parse(raw) as Partial<ReturnType<typeof persistable>> & { v?: number };
      if (data.v !== 1 || !data.grid) return;
      for (const track of TRACKS) {
        const lane = data.grid[track.id];
        if (!Array.isArray(lane) || lane.length !== 32) return;
      }
      set({
        bpm: data.bpm ?? starter.bpm,
        swing: data.swing ?? 0,
        stepCount: data.stepCount === 32 ? 32 : 16,
        grid: data.grid,
        patternId: data.patternId ?? starter.id,
        patternName: data.patternName ?? starter.name,
        genre: data.genre ?? starter.genre,
        group: data.group ?? starter.group,
        basePatternId: data.basePatternId ?? starter.id,
        feel: data.feel ?? starter.feel,
        edited: Boolean(data.edited),
        tracks: data.tracks ?? defaultMix(),
        threshold: data.threshold ?? 70,
        thresholdMaster: Boolean(data.thresholdMaster),
        sound: data.sound ?? defaultSound(),
        master: data.master ?? 0.86,
        octave: data.octave ?? 1,
        pitchClass: data.pitchClass ?? 5,
        armedNote: data.armedNote ?? 0,
        slideArm: Boolean(data.slideArm),
        paint: data.paint ?? "hit",
        active: data.active ?? "kick",
        exportBars: data.exportBars ?? 8,
        saved: data.saved ?? [],
      });
    } catch {
      /* ignore broken local saves */
    }
  },
}));

export function loadStoredBeat() {
  if (typeof localStorage === "undefined") return;
  useDrum.getState().hydrate(localStorage.getItem(STORAGE_KEY));
}

export function bindPersistence() {
  let timer = 0;
  return useDrum.subscribe((state) => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(persistable(state)));
    }, 180);
  });
}
