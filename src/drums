export const TRACKS = [
  { id: "kick", name: "Kick", short: "KICK", key: "1" },
  { id: "snare", name: "Snare", short: "SNRE", key: "2" },
  { id: "clap", name: "Clap", short: "CLAP", key: "3" },
  { id: "hat", name: "Closed Hat", short: "HAT", key: "4" },
  { id: "open", name: "Open Hat", short: "OPEN", key: "5" },
  { id: "rim", name: "Rim", short: "RIM", key: "6" },
  { id: "bell", name: "Cowbell", short: "BELL", key: "7" },
  { id: "bass", name: "808 Bass", short: "808", key: "8" },
  { id: "perc", name: "Perc", short: "PERC", key: "9" },
  { id: "crash", name: "Crash", short: "CRSH", key: "0" },
] as const;

export type TrackId = (typeof TRACKS)[number]["id"];

export const TRACK_IDS: TrackId[] = TRACKS.map((track) => track.id);

export type StepCell = {
  vel: number;
  roll: 1 | 2 | 3;
  note: number;
  slide: boolean;
};

export type Grid = Record<TrackId, StepCell[]>;

export type PaintMode = "hit" | "accent" | "ghost" | "erase";

export type TrackMix = {
  volume: number;
  mute: boolean;
  solo: boolean;
  threshold: boolean;
  lock: boolean;
};

export type Sound = {
  drive: number;
  kickDecay: number;
  kickTune: number;
  bassDecay: number;
  glide: number;
  hatLength: number;
};

export type Pattern = {
  id: string;
  name: string;
  genre: string;
  group: string;
  bpm: number;
  swing: number;
  drive: number;
  feel: string;
  stepCount: 16 | 32;
  tracks: Record<TrackId, StepCell[]>;
};

export type SavedBeat = {
  id: string;
  name: string;
  savedAt: number;
  bpm: number;
  swing: number;
  stepCount: 16 | 32;
  grid: Grid;
  octave: number;
  pitchClass: number;
  drive: number;
  threshold: number;
  thresholdMaster: boolean;
  tracks: Record<TrackId, TrackMix>;
  sound: Sound;
};

export type Schedule = {
  grid: Grid;
  stepCount: number;
  bpm: number;
  swing: number;
  threshold: number;
  thresholdMaster: boolean;
  trackThreshold: Record<TrackId, boolean>;
  trackMute: Record<TrackId, boolean>;
  trackSolo: Record<TrackId, boolean>;
  volumes: Record<TrackId, number>;
  bassRoot: number;
  sound: Sound;
  master: number;
};

export const NOTE_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"] as const;

export const GROUPS = [
  "Trap",
  "Drill",
  "South",
  "Phonk",
  "Plugg & Soul",
  "Classic",
  "Club & Global",
  "Beat Patterns",
] as const;

export function emptyCell(): StepCell {
  return { vel: 0, roll: 1, note: 0, slide: false };
}

export function midiToFreq(midi: number): number {
  return 440 * 2 ** ((midi - 69) / 12);
}

export function noteName(midi: number): string {
  const pc = ((Math.round(midi) % 12) + 12) % 12;
  const oct = Math.floor(midi / 12) - 2;
  return `${NOTE_NAMES[pc]}${oct}`;
}

export function bassRootOf(octave: number, pitchClass: number): number {
  return 24 + octave * 12 + pitchClass;
}

export const VEL_HIT = 100;
export const VEL_ACCENT = 124;
export const VEL_GHOST = 42;

import {
  TRACK_IDS,
  midiToFreq,
  type Schedule,
  type TrackId,
} from "@/lib/drums/types";

const noiseCache = new WeakMap<BaseAudioContext, AudioBuffer>();

function noiseBuffer(ctx: BaseAudioContext): AudioBuffer {
  const cached = noiseCache.get(ctx);
  if (cached) return cached;
  const length = Math.floor(ctx.sampleRate * 1.2);
  const buffer = ctx.createBuffer(1, length, ctx.sampleRate);
  const data = buffer.getChannelData(0);
  for (let index = 0; index < length; index += 1) data[index] = Math.random() * 2 - 1;
  noiseCache.set(ctx, buffer);
  return buffer;
}

export function makeDriveCurve(amount: number): Float32Array<ArrayBuffer> {
  const size = 512;
  const curve = new Float32Array(size);
  const k = 1 + amount * 32;
  for (let index = 0; index < size; index += 1) {
    const x = (index / (size - 1)) * 2 - 1;
    const shaped = ((1 + k) * x) / (1 + k * Math.abs(x));
    curve[index] = x * (1 - amount) + shaped * amount;
  }
  return curve;
}

export type Graph = {
  ctx: BaseAudioContext;
  master: GainNode;
  drive: WaveShaperNode;
  tracks: Record<TrackId, GainNode>;
  room: GainNode;
  openVoices: GainNode[];
  analyser: AnalyserNode | null;
};

function envGain(ctx: BaseAudioContext, time: number, peak: number, attack: number, dur: number): GainNode {
  const gain = ctx.createGain();
  const end = time + Math.max(dur, attack + 0.02);
  gain.gain.setValueAtTime(0.0001, time);
  gain.gain.exponentialRampToValueAtTime(Math.max(0.0001, peak), time + attack);
  gain.gain.exponentialRampToValueAtTime(0.0001, end);
  return gain;
}

function startOsc(
  ctx: BaseAudioContext,
  type: OscillatorType,
  freq: number,
  time: number,
  dur: number,
): OscillatorNode {
  const osc = ctx.createOscillator();
  osc.type = type;
  osc.frequency.setValueAtTime(Math.max(20, freq), time);
  osc.start(time);
  osc.stop(time + dur + 0.05);
  return osc;
}

function chokeOpens(graph: Graph, time: number) {
  for (const voice of graph.openVoices) {
    voice.gain.cancelScheduledValues(time);
    voice.gain.setTargetAtTime(0.0001, time, 0.012);
  }
  graph.openVoices = [];
}

function triggerKick(graph: Graph, time: number, vel: number, tune: number, decay: number) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = graph.tracks.kick;
  const osc = ctx.createOscillator();
  osc.type = "sine";
  const fund = Math.max(34, tune);
  osc.frequency.setValueAtTime(fund * 5.2, time);
  osc.frequency.exponentialRampToValueAtTime(fund, time + 0.045);
  const gain = envGain(ctx, time, 0.95 * v, 0.004, decay);
  osc.connect(gain).connect(dest);
  osc.start(time);
  osc.stop(time + decay + 0.08);

  const click = startOsc(ctx, "triangle", 1800, time, 0.03);
  click.frequency.exponentialRampToValueAtTime(180, time + 0.02);
  const clickGain = envGain(ctx, time, 0.28 * v, 0.001, 0.025);
  click.connect(clickGain).connect(dest);

  const src = ctx.createBufferSource();
  src.buffer = noiseBuffer(ctx);
  const hp = ctx.createBiquadFilter();
  hp.type = "highpass";
  hp.frequency.value = 1200;
  const ng = envGain(ctx, time, 0.18 * v, 0.001, 0.02);
  src.connect(hp).connect(ng).connect(dest);
  src.start(time);
  src.stop(time + 0.04);
}

function triggerBass(
  graph: Graph,
  time: number,
  vel: number,
  midi: number,
  slideFrom: number | null,
  glide: number,
  decay: number,
) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = graph.tracks.bass;
  const target = Math.max(28, midiToFreq(midi));
  const osc = ctx.createOscillator();
  osc.type = "sine";
  const harm = ctx.createOscillator();
  harm.type = "triangle";
  const glideAt = time + Math.max(0.02, glide);
  if (slideFrom !== null) {
    const from = Math.max(28, midiToFreq(slideFrom));
    osc.frequency.setValueAtTime(from, time);
    harm.frequency.setValueAtTime(from * 2, time);
    if (Math.abs(from - target) > 0.6) {
      osc.frequency.exponentialRampToValueAtTime(target, glideAt);
      harm.frequency.exponentialRampToValueAtTime(Math.max(30, target * 2), glideAt);
    }
  } else {
    osc.frequency.setValueAtTime(target * 1.85, time);
    osc.frequency.exponentialRampToValueAtTime(target, time + 0.035);
    harm.frequency.setValueAtTime(target * 2, time);
  }
  const harmGain = ctx.createGain();
  harmGain.gain.value = 0.16;
  const click = ctx.createOscillator();
  click.type = "sine";
  click.frequency.setValueAtTime(target * 3.2, time);
  const clickGain = envGain(ctx, time, 0.14 * v, 0.002, 0.05);
  const gain = envGain(ctx, time, 0.82 * v, 0.008, decay);
  const mix = ctx.createGain();
  osc.connect(mix);
  harm.connect(harmGain).connect(mix);
  click.connect(clickGain).connect(dest);
  mix.connect(gain).connect(dest);
  const stop = time + decay + 0.06;
  osc.start(time);
  harm.start(time);
  click.start(time);
  osc.stop(stop);
  harm.stop(stop);
  click.stop(time + 0.08);
}

function triggerSnare(graph: Graph, time: number, vel: number) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = graph.tracks.snare;
  const body = startOsc(ctx, "triangle", 196, time, 0.16);
  body.frequency.exponentialRampToValueAtTime(140, time + 0.08);
  const bodyGain = envGain(ctx, time, 0.45 * v, 0.002, 0.12);
  body.connect(bodyGain).connect(dest);

  const src = ctx.createBufferSource();
  src.buffer = noiseBuffer(ctx);
  const bp = ctx.createBiquadFilter();
  bp.type = "bandpass";
  bp.frequency.value = 1800;
  bp.Q.value = 0.7;
  const hp = ctx.createBiquadFilter();
  hp.type = "highpass";
  hp.frequency.value = 900;
  const ng = envGain(ctx, time, 0.7 * v, 0.002, 0.16);
  src.connect(bp).connect(hp).connect(ng);
  ng.connect(dest);
  const send = ctx.createGain();
  send.gain.value = 0.35;
  ng.connect(send).connect(graph.room);
  src.start(time);
  src.stop(time + 0.22);
}

function triggerClap(graph: Graph, time: number, vel: number) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = graph.tracks.clap;
  const bursts = [0, 0.011, 0.022];
  for (const offset of bursts) {
    const src = ctx.createBufferSource();
    src.buffer = noiseBuffer(ctx);
    const bp = ctx.createBiquadFilter();
    bp.type = "bandpass";
    bp.frequency.value = 1400;
    bp.Q.value = 0.8;
    const g = envGain(ctx, time + offset, 0.55 * v, 0.001, 0.03);
    src.connect(bp).connect(g).connect(dest);
    src.start(time + offset);
    src.stop(time + offset + 0.05);
  }
  const tail = ctx.createBufferSource();
  tail.buffer = noiseBuffer(ctx);
  const bp = ctx.createBiquadFilter();
  bp.type = "bandpass";
  bp.frequency.value = 1100;
  const tg = envGain(ctx, time + 0.02, 0.4 * v, 0.004, 0.16);
  tail.connect(bp).connect(tg);
  tg.connect(dest);
  const send = ctx.createGain();
  send.gain.value = 0.28;
  tg.connect(send).connect(graph.room);
  tail.start(time);
  tail.stop(time + 0.22);
}

function triggerHat(
  graph: Graph,
  time: number,
  vel: number,
  open: boolean,
  hatLength: number,
  slot: number,
) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = open ? graph.tracks.open : graph.tracks.hat;
  if (!open) chokeOpens(graph, time);
  const dur = (open ? 0.32 : 0.045) * hatLength * Math.max(0.35, slot);
  const freqs = [205.3, 369.6, 470.3, 522.7, 800.2, 1260, 1680];
  const band = ctx.createBiquadFilter();
  band.type = "highpass";
  band.frequency.value = open ? 6200 : 7600;
  const gain = envGain(ctx, time, (open ? 0.28 : 0.22) * v, 0.001, dur);
  if (open) {
    graph.openVoices.push(gain);
    if (graph.openVoices.length > 8) graph.openVoices.shift();
  }
  band.connect(gain).connect(dest);
  for (const freq of freqs) {
    const osc = startOsc(ctx, "square", freq, time, dur);
    const level = ctx.createGain();
    level.gain.value = 0.12;
    osc.connect(level).connect(band);
  }
  const src = ctx.createBufferSource();
  src.buffer = noiseBuffer(ctx);
  const ng = envGain(ctx, time, 0.16 * v, 0.001, dur);
  const hp = ctx.createBiquadFilter();
  hp.type = "highpass";
  hp.frequency.value = 8000;
  src.connect(hp).connect(ng).connect(dest);
  src.start(time);
  src.stop(time + dur + 0.02);
}

function triggerRim(graph: Graph, time: number, vel: number) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = graph.tracks.rim;
  const osc = startOsc(ctx, "triangle", 455, time, 0.05);
  const g = envGain(ctx, time, 0.4 * v, 0.001, 0.04);
  osc.connect(g).connect(dest);
  const ping = startOsc(ctx, "square", 1700, time, 0.02);
  const pg = envGain(ctx, time, 0.12 * v, 0.001, 0.018);
  ping.connect(pg).connect(dest);
}

function triggerBell(graph: Graph, time: number, vel: number) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = graph.tracks.bell;
  const filter = ctx.createBiquadFilter();
  filter.type = "bandpass";
  filter.frequency.value = 900;
  filter.Q.value = 4;
  const gain = envGain(ctx, time, 0.32 * v, 0.002, 0.18);
  filter.connect(gain).connect(dest);
  for (const freq of [540, 800]) {
    const osc = startOsc(ctx, "square", freq, time, 0.2);
    osc.connect(filter);
  }
}

function triggerPerc(graph: Graph, time: number, vel: number) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = graph.tracks.perc;
  const osc = ctx.createOscillator();
  osc.type = "sine";
  osc.frequency.setValueAtTime(220, time);
  osc.frequency.exponentialRampToValueAtTime(90, time + 0.08);
  const gain = envGain(ctx, time, 0.45 * v, 0.003, 0.18);
  osc.connect(gain).connect(dest);
  osc.start(time);
  osc.stop(time + 0.22);
  const src = ctx.createBufferSource();
  src.buffer = noiseBuffer(ctx);
  const bp = ctx.createBiquadFilter();
  bp.type = "bandpass";
  bp.frequency.value = 2400;
  const ng = envGain(ctx, time, 0.12 * v, 0.001, 0.04);
  src.connect(bp).connect(ng).connect(dest);
  src.start(time);
  src.stop(time + 0.06);
}

function triggerCrash(graph: Graph, time: number, vel: number) {
  const { ctx } = graph;
  const v = vel / 127;
  const dest = graph.tracks.crash;
  const hp = ctx.createBiquadFilter();
  hp.type = "highpass";
  hp.frequency.value = 5000;
  const gain = envGain(ctx, time, 0.34 * v, 0.004, 0.85);
  hp.connect(gain);
  gain.connect(dest);
  const send = ctx.createGain();
  send.gain.value = 0.4;
  gain.connect(send).connect(graph.room);
  const src = ctx.createBufferSource();
  src.buffer = noiseBuffer(ctx);
  src.connect(hp);
  src.start(time);
  src.stop(time + 0.95);
  for (const freq of [430, 680, 920]) {
    const osc = startOsc(ctx, "square", freq, time, 0.7);
    const level = ctx.createGain();
    level.gain.value = 0.04;
    osc.connect(level).connect(hp);
  }
}

function audible(state: Schedule, track: TrackId, vel: number): boolean {
  if (vel <= 0) return false;
  if (state.trackMute[track]) return false;
  const soloed = TRACK_IDS.some((id) => state.trackSolo[id]);
  if (soloed && !state.trackSolo[track]) return false;
  if (state.thresholdMaster && state.trackThreshold[track] && vel < state.threshold) return false;
  return true;
}

function previousBass(state: Schedule, step: number): number | null {
  const lane = state.grid.bass;
  const count = state.stepCount;
  for (let back = 1; back < count; back += 1) {
    const index = (step - back + count * 4) % count;
    const cell = lane[index];
    if (cell && audible(state, "bass", cell.vel)) return state.bassRoot + cell.note;
  }
  return null;
}

function untilNextBass(state: Schedule, step: number, stepDur: number): number {
  const count = state.stepCount;
  for (let ahead = 1; ahead <= count; ahead += 1) {
    const cell = state.grid.bass[(step + ahead) % count];
    if (cell && cell.vel > 0) return stepDur * ahead;
  }
  return stepDur * count;
}

export function scheduleStep(graph: Graph, time: number, step: number, state: Schedule, stepDur: number) {
  const when = Math.max(time, graph.ctx.currentTime);
  for (const track of TRACK_IDS) {
    const cell = state.grid[track][step];
    if (!cell || !audible(state, track, cell.vel)) continue;
    if (track === "bass") {
      const decay = Math.min(state.sound.bassDecay, Math.max(0.16, untilNextBass(state, step, stepDur) * 0.96));
      const from = cell.slide ? previousBass(state, step) : null;
      triggerBass(graph, when, cell.vel, state.bassRoot + cell.note, from, state.sound.glide, decay);
      continue;
    }
    const rolls = track === "hat" || track === "open" ? cell.roll : 1;
    for (let roll = 0; roll < rolls; roll += 1) {
      const at = when + (roll * stepDur) / rolls;
      const slot = 1 / rolls;
      if (track === "kick") triggerKick(graph, at, cell.vel, state.sound.kickTune, state.sound.kickDecay);
      else if (track === "snare") triggerSnare(graph, at, cell.vel);
      else if (track === "clap") triggerClap(graph, at, cell.vel);
      else if (track === "hat") triggerHat(graph, at, cell.vel, false, state.sound.hatLength, slot);
      else if (track === "open") triggerHat(graph, at, cell.vel, true, state.sound.hatLength, Math.max(slot, 0.8));
      else if (track === "rim") triggerRim(graph, at, cell.vel);
      else if (track === "bell") triggerBell(graph, at, cell.vel);
      else if (track === "perc") triggerPerc(graph, at, cell.vel);
      else triggerCrash(graph, at, cell.vel);
    }
  }
}

export function buildGraph(ctx: BaseAudioContext, masterVol: number, driveAmount: number): Graph {
  const master = ctx.createGain();
  master.gain.value = masterVol;
  const safety = ctx.createWaveShaper();
  const clip = new Float32Array(256);
  for (let index = 0; index < clip.length; index += 1) {
    const x = (index / (clip.length - 1)) * 2 - 1;
    clip[index] = Math.tanh(x * 1.35);
  }
  safety.curve = clip;
  safety.oversample = "2x";

  const comp = ctx.createDynamicsCompressor();
  comp.threshold.value = -14;
  comp.knee.value = 18;
  comp.ratio.value = 3.2;
  comp.attack.value = 0.004;
  comp.release.value = 0.22;

  const drive = ctx.createWaveShaper();
  drive.curve = makeDriveCurve(driveAmount);
  drive.oversample = "2x";
  const subBus = ctx.createGain();
  const drumBus = ctx.createGain();
  subBus.connect(drive).connect(comp);
  drumBus.connect(comp);
  comp.connect(safety).connect(master);

  let analyser: AnalyserNode | null = null;
  if ("createAnalyser" in ctx) {
    analyser = ctx.createAnalyser();
    analyser.fftSize = 128;
    analyser.smoothingTimeConstant = 0.72;
    master.connect(analyser);
    analyser.connect(ctx.destination);
  } else {
    master.connect(ctx.destination);
  }

  const delay = ctx.createDelay(0.5);
  delay.delayTime.value = 0.18;
  const feedback = ctx.createGain();
  feedback.gain.value = 0.26;
  const damp = ctx.createBiquadFilter();
  damp.type = "lowpass";
  damp.frequency.value = 2600;
  const room = ctx.createGain();
  const roomOut = ctx.createGain();
  roomOut.gain.value = 0.2;
  room.connect(delay).connect(damp);
  damp.connect(feedback).connect(delay);
  damp.connect(roomOut).connect(drumBus);

  const tracks = {} as Record<TrackId, GainNode>;
  for (const id of TRACK_IDS) {
    const gain = ctx.createGain();
    gain.gain.value = 0.8;
    const panner = ctx.createStereoPanner();
    const pan: Record<TrackId, number> = {
      kick: 0,
      snare: 0.06,
      clap: -0.08,
      hat: -0.18,
      open: 0.22,
      rim: 0.28,
      bell: -0.24,
      bass: 0,
      perc: 0.32,
      crash: -0.12,
    };
    panner.pan.value = pan[id];
    gain.connect(panner);
    panner.connect(id === "kick" || id === "bass" ? subBus : drumBus);
    tracks[id] = gain;
  }

  return { ctx, master, drive, tracks, room, openVoices: [], analyser };
}

const DEFAULT_VOLUMES: Record<TrackId, number> = {
  kick: 0.86,
  snare: 0.72,
  clap: 0.55,
  hat: 0.42,
  open: 0.36,
  rim: 0.46,
  bell: 0.4,
  bass: 0.74,
  perc: 0.48,
  crash: 0.4,
};

class DrumEngine {
  ctx: AudioContext | null = null;
  graph: Graph | null = null;
  analyser: AnalyserNode | null = null;
  private timer = 0;
  private nextTime = 0;
  private stepIndex = 0;
  private playing = false;
  private read: () => Schedule = () => {
    throw new Error("Engine has no state");
  };
  private onStep: (step: number) => void = () => {};
  private pending: number[] = [];
  private lastStep = 0;
  private lastTime = 0;
  private lastDur = 0.1;
  private driveAmount = -1;

  private build() {
    const ctx = new AudioContext();
    this.ctx = ctx;
    this.graph = buildGraph(ctx, 0.85, 0.3);
    this.analyser = this.graph.analyser;
    for (const id of TRACK_IDS) this.graph.tracks[id].gain.value = DEFAULT_VOLUMES[id];
  }

  async ensure() {
    if (!this.ctx || !this.graph) this.build();
    if (this.ctx && this.ctx.state !== "running") await this.ctx.resume();
    return this.ctx!;
  }

  private applyMix(state: Schedule) {
    if (!this.graph || !this.ctx) return;
    const now = this.ctx.currentTime;
    this.graph.master.gain.setTargetAtTime(state.master, now, 0.02);
    for (const id of TRACK_IDS) {
      this.graph.tracks[id].gain.setTargetAtTime(state.volumes[id], now, 0.02);
    }
    if (state.sound.drive !== this.driveAmount) {
      this.driveAmount = state.sound.drive;
      this.graph.drive.curve = makeDriveCurve(state.sound.drive);
    }
  }

  private tick = () => {
    if (!this.playing || !this.ctx || !this.graph) return;
    const state = this.read();
    this.applyMix(state);
    const stepDur = 60 / Math.max(40, state.bpm) / 4;
    this.lastDur = stepDur;
    while (this.nextTime < this.ctx.currentTime + 0.14) {
      const count = Math.max(1, state.stepCount);
      const step = this.stepIndex % count;
      const swing = step % 2 === 1 ? state.swing * stepDur : 0;
      const at = this.nextTime + swing;
      scheduleStep(this.graph, at, step, state, stepDur);
      this.lastStep = step;
      this.lastTime = at;
      const wait = Math.max(0, (at - this.ctx.currentTime) * 1000);
      const token = window.setTimeout(() => this.onStep(step), wait);
      this.pending.push(token);
      this.nextTime += stepDur;
      this.stepIndex = (step + 1) % count;
    }
  };

  async start(read: () => Schedule, onStep: (step: number) => void) {
    this.read = read;
    this.onStep = onStep;
    await this.ensure();
    if (!this.ctx || !this.graph) return;
    this.stop(false);
    this.playing = true;
    this.stepIndex = 0;
    this.nextTime = this.ctx.currentTime + 0.05;
    this.graph.openVoices = [];
    this.applyMix(this.read());
    this.timer = window.setInterval(this.tick, 25);
    this.tick();
  }

  stop(clearHead = true) {
    this.playing = false;
    window.clearInterval(this.timer);
    for (const token of this.pending) window.clearTimeout(token);
    this.pending = [];
    if (clearHead) this.onStep(-1);
  }

  quantize(stepCount: number): number {
    if (!this.playing || !this.ctx) return 0;
    const elapsed = this.ctx.currentTime - this.lastTime;
    if (elapsed > this.lastDur * 0.5) return (this.lastStep + 1) % stepCount;
    return this.lastStep;
  }

  async preview(track: TrackId, vel: number, midi: number | null, slideFrom: number | null) {
    await this.ensure();
    if (!this.graph || !this.ctx) return;
    const state = this.read();
    this.applyMix(state);
    const time = this.ctx.currentTime;
    if (track === "kick") triggerKick(this.graph, time, vel, state.sound.kickTune, state.sound.kickDecay);
    else if (track === "snare") triggerSnare(this.graph, time, vel);
    else if (track === "clap") triggerClap(this.graph, time, vel);
    else if (track === "hat") triggerHat(this.graph, time, vel, false, state.sound.hatLength, 1);
    else if (track === "open") triggerHat(this.graph, time, vel, true, state.sound.hatLength, 1);
    else if (track === "rim") triggerRim(this.graph, time, vel);
    else if (track === "bell") triggerBell(this.graph, time, vel);
    else if (track === "perc") triggerPerc(this.graph, time, vel);
    else if (track === "crash") triggerCrash(this.graph, time, vel);
    else if (midi !== null) {
      triggerBass(this.graph, time, vel, midi, slideFrom, state.sound.glide, Math.min(0.7, state.sound.bassDecay));
    }
  }
}

export const engine = new DrumEngine();

import { buildGraph, scheduleStep } from "@/lib/drums/engine";
import type { Schedule } from "@/lib/drums/types";

function floatTo16(input: Float32Array): Int16Array {
  const out = new Int16Array(input.length);
  for (let index = 0; index < input.length; index += 1) {
    const sample = Math.max(-1, Math.min(1, input[index] ?? 0));
    out[index] = sample < 0 ? sample * 0x8000 : sample * 0x7fff;
  }
  return out;
}

export async function renderLoop(state: Schedule, bars: number): Promise<AudioBuffer> {
  const safeBpm = Math.max(40, state.bpm);
  const secondsPerBar = (60 / safeBpm) * 4;
  const duration = bars * secondsPerBar + 1.5;
  const sampleRate = 44100;
  const ctx = new OfflineAudioContext(2, Math.ceil(sampleRate * duration), sampleRate);
  const graph = buildGraph(ctx, state.master, state.sound.drive);
  for (const id of Object.keys(state.volumes) as (keyof Schedule["volumes"])[]) {
    graph.tracks[id].gain.value = state.volumes[id];
  }
  const stepDur = 60 / safeBpm / 4;
  const total = bars * state.stepCount;
  for (let index = 0; index < total; index += 1) {
    const step = index % state.stepCount;
    const swing = step % 2 === 1 ? state.swing * stepDur : 0;
    scheduleStep(graph, index * stepDur + swing, step, state, stepDur);
  }
  const audio = await ctx.startRendering();
  let peak = 0;
  const channel = audio.getChannelData(0);
  for (let index = 0; index < channel.length; index += 32) {
    peak = Math.max(peak, Math.abs(channel[index] ?? 0));
  }
  if (peak < 0.001) throw new Error("That loop rendered silent. Add a hit, then bounce again.");
  return audio;
}

export async function audioBufferToMp3(buffer: AudioBuffer): Promise<Blob> {
  const { Mp3Encoder } = await import("@breezystack/lamejs");
  const encoder = new Mp3Encoder(2, buffer.sampleRate, 192);
  const left = floatTo16(buffer.getChannelData(0));
  const right = floatTo16(buffer.getChannelData(buffer.numberOfChannels > 1 ? 1 : 0));
  const block = 1152;
  const parts: Uint8Array[] = [];
  for (let index = 0; index < left.length; index += block) {
    const chunk = encoder.encodeBuffer(left.subarray(index, index + block), right.subarray(index, index + block));
    if (chunk.length > 0) parts.push(chunk);
  }
  const end = encoder.flush();
  if (end.length > 0) parts.push(end);
  return new Blob(parts as BlobPart[], { type: "audio/mpeg" });
}

export function downloadBlob(blob: Blob, filename: string) {
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.download = filename;
  document.body.appendChild(link);
  link.click();
  link.remove();
  window.setTimeout(() => URL.revokeObjectURL(url), 1500);
}

