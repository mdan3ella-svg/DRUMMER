@import "tailwindcss";

@theme {
  --color-bg: #090a08;
  --color-surface: #141612;
  --color-surface-2: #1c1f18;
  --color-surface-3: #262a20;
  --color-fg: #f4f1e8;
  --color-muted: #8d8a7c;
  --color-primary: #d6ff3f;
  --color-record: #ff3b30;
  --color-border: #2e3328;
  --font-display: "Oswald", sans-serif;
  --font-sans: "Outfit", ui-sans-serif, system-ui, sans-serif;
  --radius-sm: 0.375rem;
  --radius-md: 0.75rem;
  --radius-lg: 1rem;
}

@layer base {
  button:not(:disabled),
  [role="button"]:not(:disabled) {
    cursor: pointer;
  }

  html,
  body {
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-sans);
  }

  body {
    min-height: 100vh;
  }

  ::selection {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  input[type="range"] {
    accent-color: var(--color-primary);
    width: 100%;
    height: 1.75rem;
  }

  button,
  a {
    touch-action: manipulation;
  }
}

@keyframes drummer-hit {
  from {
    transform: translateY(1px) scale(0.97);
  }
  to {
    transform: none;
  }
}

@keyframes drummer-hit-b {
  from {
    transform: translateY(1px) scale(0.97);
  }
  to {
    transform: none;
  }
}

@keyframes drummer-blink {
  50% {
    opacity: 0.35;
  }
}

.pad-flash-a {
  animation: drummer-hit 140ms ease-out;
}

.pad-flash-b {
  animation: drummer-hit-b 140ms ease-out;
}

.rec-blink {
  animation: drummer-blink 1s steps(1) infinite;
}

@media (prefers-reduced-motion: reduce) {
  .pad-flash-a,
  .pad-flash-b,
  .rec-blink {
    animation: none;
  }
}
