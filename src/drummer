              <button
                type="button"
                className={`h-11 rounded-md px-3 text-sm ${drum.stepCount === 32 ? "bg-primary text-bg" : "border border-border bg-surface-2"}`}
                onClick={() => drum.setStepCount(32)}
              >
                2 bars
              </button>
              {drum.stepCount === 32 ? (
                <>
                  <button
                    type="button"
                    className={`h-11 rounded-md px-3 text-sm ${drum.page === 0 ? "bg-fg text-bg" : "border border-border"}`}
                    onClick={() => drum.setPage(0)}
                  >
                    Bar 1
                  </button>
                  <button
                    type="button"
                    className={`h-11 rounded-md px-3 text-sm ${drum.page === 1 ? "bg-fg text-bg" : "border border-border"}`}
                    onClick={() => drum.setPage(1)}
