            <div className="mb-3 rounded-md border border-border bg-bg p-3">
              <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
                <h3 className="font-display text-xl tracking-wide">{active.name}</h3>
                <button
                  type="button"
                  className="h-11 rounded-md border border-border px-3 text-sm"
                  onClick={() => drum.clearTrack(drum.active)}
                >
                  Clear lane
                </button>
              </div>
              <label className="mb-2 flex items-center gap-3 text-sm text-muted" htmlFor="lane-volume">
                Level
                <input
                  id="lane-volume"
                  type="range"
                  min={0}
                  max={1}
                  step={0.01}
                  value={mix.volume}
                  onChange={(event) => drum.setVolume(drum.active, Number(event.target.value))}
                />
              </label>
              <div className="grid grid-cols-4 gap-2">
                <button
                  type="button"
                  aria-pressed={mix.mute}
                  className={`h-11 rounded-md text-sm ${mix.mute ? "bg-record text-fg" : "border border-border bg-surface-2"}`}
                  onClick={() => drum.toggleMute(drum.active)}
                >
                  Mute
                </button>
                <button
                  type="button"
                  aria-pressed={mix.solo}
                  className={`h-11 rounded-md text-sm ${mix.solo ? "bg-primary text-bg" : "border border-border bg-surface-2"}`}
                  onClick={() => drum.toggleSolo(drum.active)}
                >
                  Solo
                </button>
                <button
                  type="button"
                  aria-pressed={mix.threshold}
                  className={`h-11 rounded-md text-sm ${mix.threshold ? "bg-primary text-bg" : "border border-border bg-surface-2"}`}
                  onClick={() => drum.toggleTrackThreshold(drum.active)}
                >
                  THR
                </button>
                <button
                  type="button"
                  aria-pressed={mix.lock}
                  className={`flex h-11 items-center justify-center gap-1 rounded-md text-sm ${mix.lock ? "bg-fg text-bg" : "border border-border bg-surface-2"}`}
