                ))}
              </div>
            </div>
            <div className="mb-3 flex gap-2 overflow-x-auto pb-1">
              {NOTE_NAMES.map((name, index) => (
                <button
                  key={name}
                  type="button"
                  className={`h-11 min-w-11 shrink-0 rounded-md px-2 text-sm ${drum.pitchClass === index ? "bg-primary text-bg" : name.includes("#") ? "bg-bg text-muted" : "border border-border bg-surface-2 text-fg"}`}
                  onClick={() => drum.setKey(index)}
                >
                  {name}
                </button>
              ))}
            </div>
            <p className="mb-2 text-xs text-muted">Armed note for the next 808 step. Tap a key, then paint the 808 lane.</p>
            <div className="flex gap-2 overflow-x-auto pb-1">
              {Array.from({ length: 13 }, (_, index) => {
                const midi = root + index;
                const armed = drum.armedNote === index;
                return (
                  <button
                    key={midi}
                    type="button"
                    className={`h-11 min-w-12 shrink-0 rounded-md px-2 text-sm ${armed ? "bg-fg text-bg" : "border border-border bg-surface-2"}`}
                    onClick={() => {
                      drum.setArmed(index);
                      drum.setActive("bass");
                      void engine.preview("bass", VEL_HIT, midi, drum.slideArm ? midi - 5 : null);
                    }}
                  >
                    {noteName(midi)}
                  </button>
                );
              })}
            </div>
            <button
              type="button"
              aria-pressed={drum.slideArm}
              className={`mt-3 h-11 rounded-md px-3 text-sm ${drum.slideArm ? "bg-primary text-bg" : "border border-border bg-surface-2"}`}
              onClick={() => drum.toggleSlideArm()}
            >
              Slide into next 808
            </button>
          </section>
        </div>

        <div className="flex min-w-0 flex-col gap-4">
          <section className="rounded-lg border border-border bg-surface p-3" aria-label="Pattern library">
            <div className="mb-3 flex items-center justify-between gap-2">
              <h2 className="font-display text-lg tracking-wide">PATTERNS</h2>
              <span className="text-sm text-muted">{PATTERNS.length}</span>
            </div>
            <input
              className="mb-3 h-11 w-full rounded-md border border-border bg-bg px-3 text-sm text-fg select-text"
              placeholder="Search trap, drill, phonk…"
              value={query}
              onChange={(event) => setQuery(event.target.value)}
              aria-label="Search patterns"
            />
            <div className="mb-3 flex gap-2 overflow-x-auto pb-1">
              {["All", ...GROUPS].map((name) => (
                <button
                  key={name}
                  type="button"
                  className={`h-11 shrink-0 rounded-md px-3 text-sm ${group === name ? "bg-primary text-bg" : "border border-border bg-surface-2 text-fg"}`}
                  onClick={() => setGroup(name)}
                >
                  {name}
                </button>
              ))}
            </div>
            <div className="flex max-h-96 flex-col gap-2 overflow-y-auto pr-1">
              {filtered.map((pattern) => {
                const selected = drum.basePatternId === pattern.id && drum.patternId === pattern.id;
                return (
                  <button
                    key={pattern.id}
                    type="button"
                    className={`rounded-md border px-3 py-3 text-left ${selected ? "border-primary bg-surface-3" : "border-border bg-bg"}`}
                    onClick={() => drum.loadPattern(pattern.id)}
                  >
                    <span className="flex items-baseline justify-between gap-2">
                      <span className="font-medium">{pattern.name}</span>
                      <span className="text-xs text-muted">{pattern.bpm}</span>
                    </span>
                    <span className="mt-1 block text-xs text-primary">{pattern.genre}</span>
                    <span className="mt-1 block text-sm text-muted">{pattern.feel}</span>
                  </button>
                );
              })}
              {filtered.length === 0 ? <p className="text-sm text-muted">No patterns in this lane.</p> : null}
            </div>
            <button
              type="button"
              className="mt-3 h-11 w-full rounded-md border border-border text-sm"
              onClick={() => drum.blank()}
            >
              Blank grid
            </button>
          </section>

          <section className="rounded-lg border border-border bg-surface p-3" aria-label="My beats">
            <h2 className="mb-3 font-display text-lg tracking-wide">MY BEATS</h2>
            <form
              className="mb-3 flex gap-2"
              onSubmit={(event) => {
                event.preventDefault();
                drum.saveBeat(beatName);
                setBeatName("");
              }}
            >
              <input
                className="h-11 min-w-0 flex-1 rounded-md border border-border bg-bg px-3 text-sm select-text"
                placeholder="Name this beat"
                value={beatName}
                onChange={(event) => setBeatName(event.target.value)}
                aria-label="Beat name"
              />
              <button type="submit" className="flex h-11 items-center gap-2 rounded-md bg-primary px-3 text-sm font-medium text-bg">
                <Save className="size-4" />
                Save
              </button>
            </form>
            <div className="flex flex-col gap-2">
              {drum.saved.length === 0 ? (
                <p className="text-sm text-muted">Saves stay in this browser.</p>
              ) : (
                drum.saved.map((beat) => (
                  <div key={beat.id} className="flex items-center gap-2">
                    <button
                      type="button"
                      className="h-11 min-w-0 flex-1 truncate rounded-md border border-border bg-bg px-3 text-left text-sm"
                      onClick={() => drum.loadBeat(beat.id)}
                    >
                      {beat.name}
                      <span className="ml-2 text-muted">{beat.bpm}</span>
                    </button>
                    <button
                      type="button"
                      className="flex h-11 w-11 items-center justify-center rounded-md border border-border"
                      aria-label={`Delete ${beat.name}`}
                      onClick={() => drum.deleteBeat(beat.id)}
                    >
                      <Trash2 className="size-4" />
                    </button>
                  </div>
                ))
              )}
            </div>
          </section>

          <section className="rounded-lg border border-border bg-surface p-3" aria-label="Mix">
            <h2 className="mb-3 font-display text-lg tracking-wide">MIX</h2>
            <div className="grid gap-3 sm:grid-cols-2">
              <Slider label="Swing" value={drum.swing} min={0} max={0.65} step={0.01} display={`${Math.round(drum.swing * 100)}%`} onChange={drum.setSwing} />
              <Slider label="Drive" value={drum.sound.drive} min={0} max={1} step={0.01} display={`${Math.round(drum.sound.drive * 100)}`} onChange={(value) => drum.setSound({ drive: value })} />
              <Slider label="Master" value={drum.master} min={0} max={1} step={0.01} display={`${Math.round(drum.master * 100)}`} onChange={drum.setMaster} />
              <Slider label="Kick decay" value={drum.sound.kickDecay} min={0.18} max={1.3} step={0.01} display={drum.sound.kickDecay.toFixed(2)} onChange={(value) => drum.setSound({ kickDecay: value })} />
              <Slider label="Kick tune" value={drum.sound.kickTune} min={36} max={72} step={1} display={`${Math.round(drum.sound.kickTune)} Hz`} onChange={(value) => drum.setSound({ kickTune: value })} />
              <Slider label="808 decay" value={drum.sound.bassDecay} min={0.3} max={2} step={0.01} display={drum.sound.bassDecay.toFixed(2)} onChange={(value) => drum.setSound({ bassDecay: value })} />
              <Slider label="Glide" value={drum.sound.glide} min={0.02} max={0.22} step={0.01} display={drum.sound.glide.toFixed(2)} onChange={(value) => drum.setSound({ glide: value })} />
              <Slider label="Hat length" value={drum.sound.hatLength} min={0.45} max={1.8} step={0.01} display={drum.sound.hatLength.toFixed(2)} onChange={(value) => drum.setSound({ hatLength: value })} />
            </div>
            <div className="mt-4 flex flex-col gap-3">
              {TRACKS.map((track) => (
                <Slider
                  key={track.id}
                  label={track.name}
                  value={drum.tracks[track.id].volume}
                  min={0}
                  max={1}
                  step={0.01}
                  display={`${Math.round(drum.tracks[track.id].volume * 100)}`}
                  onChange={(value) => drum.setVolume(track.id, value)}
                />
              ))}
            </div>
          </section>
        </div>
      </div>
    </main>
  );
}

function Slider({
  label,
  value,
  min,
  max,
  step,
  display,
  onChange,
}: {
  label: string;
  value: number;
  min: number;
  max: number;
  step: number;
  display: string;
  onChange: (value: number) => void;
}) {
  const id = `mix-${label.replace(/\s+/g, "-").toLowerCase()}`;
  return (
    <label htmlFor={id} className="flex flex-col gap-1 text-sm">
      <span className="flex items-center justify-between gap-3 text-muted">
        <span>{label}</span>
        <span className="font-medium text-fg">{display}</span>
      </span>
      <input
        id={id}
        type="range"
        min={min}
        max={max}
        step={step}
        value={value}
        onChange={(event) => onChange(Number(event.target.value))}
      />
    </label>
  );
}
