function slug(value: string): string {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

function Meter() {
  const ref = useRef<HTMLCanvasElement>(null);
  useEffect(() => {
    const canvas = ref.current;
    if (!canvas) return;
    const context = canvas.getContext("2d");
    if (!context) return;
    let frame = 0;
    const buffer = new Uint8Array(64);
    const draw = () => {
      const styles = getComputedStyle(canvas);
      const primary = styles.getPropertyValue("--color-primary").trim() || "#d6ff3f";
      const muted = styles.getPropertyValue("--color-border").trim() || "#2e3328";
      const { width, height } = canvas;
      context.clearRect(0, 0, width, height);
      const analyser = engine.analyser;
      if (analyser) analyser.getByteFrequencyData(buffer);
      const bars = 28;
      const gap = 3;
      const barWidth = (width - gap * (bars - 1)) / bars;
      for (let index = 0; index < bars; index += 1) {
        const raw = analyser ? (buffer[index + 2] ?? 0) / 255 : 0;
        const level = Math.max(0.04, raw);
        const barHeight = level * height;
        context.fillStyle = raw > 0.72 ? primary : muted;
        context.fillRect(index * (barWidth + gap), height - barHeight, barWidth, barHeight);
      }
      frame = window.requestAnimationFrame(draw);
    };
    frame = window.requestAnimationFrame(draw);
    return () => window.cancelAnimationFrame(frame);
  }, []);
  return <canvas ref={ref} width={420} height={36} className="h-9 w-full" aria-hidden="true" />;
}

function StepButton({
  cell,
  index,
  track,
  root,
  hot,
  gated,
  cursor,
  onTap,
  onHold,
}: {
  cell: StepCell;
  index: number;
  track: TrackId;
  root: number;
  hot: boolean;
  gated: boolean;
  cursor: boolean;
  onTap: () => void;
  onHold: () => void;
}) {
  const suppress = useRef(false);
  const timer = useRef(0);
  const beat = index % 4 === 0;
  let tone = "border-border bg-surface-2 text-muted";
  if (cell.vel >= 120) tone = "border-fg bg-fg text-bg";
  else if (cell.vel >= 80) tone = "border-primary bg-primary text-bg";
  else if (cell.vel > 0) tone = "border-primary bg-surface-3 text-primary";
  const ring = hot ? "ring-2 ring-record" : cursor ? "ring-2 ring-primary" : "";
  const label =
    track === "bass" && cell.vel > 0
      ? noteName(root + cell.note)
      : cell.roll > 1
        ? `x${cell.roll}`
        : "";
  return (
    <button
      type="button"
      aria-label={`${track} step ${index + 1}${cell.vel ? `, velocity ${cell.vel}` : ", off"}${cell.slide ? ", slide" : ""}`}
      aria-pressed={cell.vel > 0}
      className={`relative h-11 w-11 shrink-0 rounded-sm border text-xs font-medium ${tone} ${ring} ${beat ? "" : ""} ${gated ? "opacity-40" : ""} ${index % 4 === 3 ? "mr-2" : ""}`}
      onPointerDown={() => {
        suppress.current = false;
        timer.current = window.setTimeout(() => {
          suppress.current = true;
          onHold();
        }, 380);
      }}
      onPointerUp={() => window.clearTimeout(timer.current)}
      onPointerLeave={() => window.clearTimeout(timer.current)}
      onPointerCancel={() => window.clearTimeout(timer.current)}
      onContextMenu={(event) => event.preventDefault()}
      onClick={() => {
        if (suppress.current) {
          suppress.current = false;
          return;
        }
        onTap();
      }}
    >
      {label}
      {cell.slide ? <span className="absolute right-0.5 bottom-0.5 text-xs leading-none">gl</span> : null}
    </button>
  );
}

export function Studio() {
  const drum = useDrum();
  const [exporting, setExporting] = useState(false);
  const [exportNote, setExportNote] = useState("");
  const [query, setQuery] = useState("");
  const [group, setGroup] = useState<string>("All");
  const [beatName, setBeatName] = useState("");
  const [flashes, setFlashes] = useState<Record<string, number>>({});
  const root = bassRootOf(drum.octave, drum.pitchClass);
  const active = TRACKS.find((track) => track.id === drum.active) ?? TRACKS[0];
  const mix = drum.tracks[drum.active];
  const offset = drum.page * 16;
  const visible = drum.stepCount === 32 ? 16 : 16;

  useEffect(() => {
    loadStoredBeat();
    const unbind = bindPersistence();
    return () => {
      unbind();
      engine.stop();
    };
  }, []);

  useEffect(() => {
    const onKey = (event: KeyboardEvent) => {
      const target = event.target as HTMLElement | null;
      if (target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.tagName === "SELECT")) {
        return;
      }
      if (event.code === "Space") {
        event.preventDefault();
        void togglePlay();
        return;
      }
      const pad = TRACKS.find((track) => track.key === event.key);
      if (pad) {
        event.preventDefault();
        void hitPad(pad.id);
      }
    };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  });

  async function togglePlay() {
    const state = useDrum.getState();
    if (state.playing) {
      engine.stop();
      state.togglePlayFlag(false);
      return;
    }
    state.togglePlayFlag(true);
    try {
      await engine.start(
        () => toSchedule(useDrum.getState()),
        (step) => useDrum.getState().setStep(step),
      );
    } catch {
      useDrum.getState().togglePlayFlag(false);
    }
  }

  function stop() {
    engine.stop();
    useDrum.getState().togglePlayFlag(false);
  }

  async function hitPad(track: TrackId) {
    const state = useDrum.getState();
    const vel = state.paint === "ghost" ? VEL_GHOST : state.paint === "accent" ? VEL_ACCENT : VEL_HIT;
    const midi = bassRootOf(state.octave, state.pitchClass) + state.armedNote;
    let slideFrom: number | null = null;
    if (track === "bass" && state.slideArm) {
      slideFrom = midi - 5;
    }
    setFlashes((current) => ({ ...current, [track]: (current[track] ?? 0) + 1 }));
    void engine.preview(track, vel, track === "bass" ? midi : null, slideFrom);
    state.setActive(track);
    if (!state.recording || state.paint === "erase") return;
    const index = state.playing ? engine.quantize(state.stepCount) : state.cursor;
    useDrum.getState().stampStep(track, index);
    if (!state.playing) useDrum.getState().advanceCursor();
  }

  async function bounce() {
    const state = useDrum.getState();
    setExporting(true);
    setExportNote("Rendering the loop…");
    try {
      const audio = await renderLoop(toSchedule(state), state.exportBars);
      const blob = await audioBufferToMp3(audio);
      const filename = `DRUMMER-${slug(state.patternName) || "beat"}-${state.bpm}.mp3`;
      downloadBlob(blob, filename);
      setExportNote(`Saved ${filename}`);
    } catch (error) {
      setExportNote(error instanceof Error ? error.message : "Export failed");
    } finally {
      setExporting(false);
    }
  }

  const filtered = PATTERNS.filter((pattern) => {
    const hay = `${pattern.name} ${pattern.genre} ${pattern.group}`.toLowerCase();
    const matchesGroup = group === "All" || pattern.group === group;
    return matchesGroup && hay.includes(query.trim().toLowerCase());
  });

  const bar = drum.step < 0 ? 1 : Math.floor(drum.step / 16) + 1;
  const beat = drum.step < 0 ? 1 : Math.floor((drum.step % 16) / 4) + 1;
  const sub = drum.step < 0 ? 1 : (drum.step % 4) + 1;

  return (
    <main className="min-h-screen bg-bg text-fg select-none">
      <header className="sticky top-0 z-30 border-b border-border bg-bg/95 backdrop-blur">
        <div className="mx-auto flex max-w-6xl flex-wrap items-center gap-3 px-3 py-3">
          <div className="min-w-36 flex-1">
            <h1 className="font-display text-4xl leading-none tracking-wider">DRUMMER</h1>
            <p className="text-xs tracking-widest text-primary">808 TRAP MACHINE</p>
          </div>
          <div className="flex items-center gap-2">
            <label className="flex items-center gap-1 text-sm text-muted" htmlFor="bpm">
              BPM
              <input
                id="bpm"
                className="w-16 rounded-sm border border-border bg-surface px-2 py-2 text-center font-display text-2xl leading-none text-fg select-text"
                type="number"
                min={60}
                max={190}
                value={drum.bpm}
                onChange={(event) => drum.setBpm(Number(event.target.value))}
              />
            </label>
            <p className="hidden font-display text-lg text-muted sm:block" aria-live="polite">
              {bar}.{beat}.{sub}
            </p>
          </div>
          <div className="flex items-center gap-2">
            <button
              type="button"
              className={`flex h-12 w-12 items-center justify-center rounded-md ${drum.playing ? "bg-primary text-bg" : "bg-primary text-bg"}`}
              aria-label={drum.playing ? "Playing" : "Play"}
              aria-pressed={drum.playing}
              onClick={() => void togglePlay()}
            >
              <Play className="size-5" fill="currentColor" />
            </button>
            <button
              type="button"
              className="flex h-12 w-12 items-center justify-center rounded-md border border-border bg-surface text-fg"
              aria-label="Stop"
              onClick={stop}
            >
              <Square className="size-4" fill="currentColor" />
            </button>
            <button
              type="button"
              className={`flex h-12 items-center gap-2 rounded-md border px-3 ${drum.recording ? "border-record bg-record text-fg" : "border-border bg-surface text-fg"}`}
              aria-pressed={drum.recording}
              onClick={() => drum.toggleRecording()}
            >
              <Circle className={`size-3 ${drum.recording ? "rec-blink" : ""}`} fill="currentColor" />
              Rec
            </button>
          </div>
          <div className="flex flex-wrap items-center gap-2">
            <div className="flex overflow-hidden rounded-md border border-border">
              {[4, 8, 16].map((bars) => (
                <button
                  key={bars}
                  type="button"
                  className={`h-11 px-3 text-sm ${drum.exportBars === bars ? "bg-primary text-bg" : "bg-surface text-muted"}`}
                  onClick={() => drum.setExportBars(bars as 4 | 8 | 16)}
                >
                  {bars}
                </button>
              ))}
            </div>
            <button
              type="button"
              className="flex h-11 items-center gap-2 rounded-md bg-fg px-3 text-sm font-medium text-bg disabled:opacity-50"
              onClick={() => void bounce()}
              disabled={exporting}
            >
              <Download className="size-4" />
              {exporting ? "Rendering" : "Record MP3"}
            </button>
          </div>
        </div>
        <div className="mx-auto max-w-6xl px-3 pb-3">
          <Meter />
          <p className="mt-1 truncate text-sm text-muted">
            {drum.genre} · {drum.patternName}
            {drum.edited ? " · edited" : ""} · key {noteName(root)}
            {drum.recording ? (drum.playing ? " · printing pads onto the grid" : ` · step rec ${drum.cursor + 1}`) : ""}
          </p>
          <p className="text-sm text-fg" aria-live="polite">
            {exportNote}
          </p>
        </div>
      </header>

      <div className="mx-auto grid max-w-6xl gap-4 px-3 py-4 lg:grid-cols-[minmax(0,1.45fr)_minmax(18rem,0.8fr)]">
        <div className="flex min-w-0 flex-col gap-4">
          <section className="rounded-lg border border-border bg-surface p-3" aria-label="Drum pads">
            <div className="mb-3 flex items-end justify-between gap-2">
              <h2 className="font-display text-lg tracking-wide">PADS</h2>
              <p className="text-xs text-muted">Keys 1–0 · space plays</p>
            </div>
            <div className="grid grid-cols-5 gap-2">
              {TRACKS.map((track) => {
                const flash = flashes[track.id] ?? 0;
                const selected = drum.active === track.id;
                return (
                  <button
                    key={track.id}
                    type="button"
                    className={`flex h-16 flex-col items-start justify-between rounded-md border px-2 py-2 sm:h-20 ${flash % 2 === 1 ? "pad-flash-a" : "pad-flash-b"} ${selected ? "border-primary bg-surface-3" : "border-border bg-surface-2"}`}
                    onClick={() => void hitPad(track.id)}
                  >
                    <span className="text-xs text-muted">{track.key}</span>
                    <span className="font-display text-lg leading-none tracking-wide sm:text-xl">{track.short}</span>
                  </button>
                );
              })}
            </div>
          </section>

          <section className="rounded-lg border border-border bg-surface p-3" aria-label="Sequencer">
            <div className="mb-3 flex flex-wrap items-end justify-between gap-2">
              <div>
                <h2 className="font-display text-lg tracking-wide">SEQUENCER</h2>
                <p className="text-sm text-muted">{drum.feel}</p>
              </div>
              <div className="flex flex-wrap gap-2">
                <button
                  type="button"
                  className="flex h-11 items-center gap-2 rounded-md border border-border bg-surface-2 px-3 text-sm"
                  onClick={() => drum.undo()}
                >
                  <Undo2 className="size-4" />
                  Undo
                </button>
                <button
                  type="button"
                  className="flex h-11 items-center gap-2 rounded-md border border-border bg-surface-2 px-3 text-sm"
