                <button
                  type="button"
                  className={`h-11 rounded-md px-3 text-sm ${drum.thresholdMaster && drum.threshold === 70 ? "bg-primary text-bg" : "bg-surface-2 text-fg"}`}
                  onClick={() => {
                    drum.setThresholdMaster(true);
                    drum.setThreshold(70);
                  }}
                >
                  Drop ghosts
                </button>
                <button
                  type="button"
                  className={`h-11 rounded-md px-3 text-sm ${drum.thresholdMaster && drum.threshold === 112 ? "bg-fg text-bg" : "bg-surface-2 text-fg"}`}
                  onClick={() => {
                    drum.setThresholdMaster(true);
                    drum.setThreshold(112);
                  }}
                >
                  Accents only
                </button>
              </div>
              <label className="flex flex-col gap-1 text-sm" htmlFor="threshold">
                <span className="flex justify-between text-muted">
                  <span>Level {drum.threshold}</span>
                  <span>Ghost 42 · Hit 100 · Accent 124</span>
                </span>
                <input
