                  <RotateCcw className="size-4" />
                  Reset
                </button>
              </div>
            </div>

            <div className="mb-3 flex flex-wrap gap-2">
              {PAINTS.map((mode) => (
                <button
                  key={mode.id}
                  type="button"
                  aria-pressed={drum.paint === mode.id}
                  className={`h-11 flex-1 rounded-md border px-2 text-sm font-medium ${drum.paint === mode.id ? "border-primary bg-primary text-bg" : "border-border bg-surface-2 text-fg"}`}
                  onClick={() => drum.setPaint(mode.id)}
                >
                  {mode.label}
